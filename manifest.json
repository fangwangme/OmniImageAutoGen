{
  "manifest_version": 3,
  "name": "OmniImageAutoGen",
  "version": "0.1.0",
  "description": "Batch-generate and save full-size images from ChatGPT or Gemini with precise file names",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://chatgpt.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content.js",
        "chunks/*.js"
      ],
      "matches": [
        "https://gemini.google.com/*",
        "https://chatgpt.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "Open OmniImageAutoGen"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
